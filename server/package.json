{
  "name": "verse-explorer-backend",
  "version": "1.0.0",
  "description": "Express proxy server for Quran.Foundation API with OAuth2 and caching",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx server.ts",
    "dev:watch": "nodemon --watch './**/*.ts' --exec 'tsx' server.ts",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "lru-cache": "^10.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
